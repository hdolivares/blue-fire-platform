# Blue Fire Platform - Production Environment Variables
# Copy the appropriate sections to your .env files after SSL setup

# ===========================================
# Frontend Environment Variables
# Copy these to: frontend/.env.local
# ===========================================
NEXT_PUBLIC_API_URL=https://app.bluefire.love/api

# ===========================================  
# Backend Environment Variables
# Copy these to: backend/.env
# ===========================================
FRONTEND_URL=https://app.bluefire.love
PORT=3001
NODE_ENV=production

# CORS Configuration (already handled by FRONTEND_URL above)
# The backend will automatically use FRONTEND_URL for CORS origin

# ===========================================
# Additional Production Settings
# Add your production configs below:
# ===========================================

# Database
# MONGODB_URI=mongodb://your-production-db

# Email Service
# EMAIL_HOST=your-smtp-server
# EMAIL_PORT=587
# EMAIL_USER=your-email
# EMAIL_PASS=your-password

# JWT Secret
# JWT_SECRET=your-super-secret-jwt-key

# Cloudinary (if using)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key  
# CLOUDINARY_API_SECRET=your-api-secret 